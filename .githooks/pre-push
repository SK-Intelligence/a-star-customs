#!/bin/sh
# Blocks a push to main unless the fast checks pass (ESLint, types, Ruff lint + format, forbidden text, backend
# tests, catalog sync). Enable once per clone: npm run setup:hooks
# The Quality gate on GitHub still runs the full suite; this only stops the obvious breakage early.
protected=0
while read -r _ _ remote_ref _; do
  case "$remote_ref" in
    refs/heads/main) protected=1 ;;
  esac
done
[ "$protected" = 1 ] || exit 0
repo_root=$(git rev-parse --show-toplevel) || exit 1
echo "pre-push: pushing main, running npm run ci:fast ..."
cd "$repo_root" && npm run ci:fast
status=$?
if [ "$status" -ne 0 ]; then
  echo "pre-push: ci:fast failed, push blocked. Fix it, or push a feature branch and open a pull request." >&2
  exit "$status"
fi
