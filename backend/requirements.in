# Runtime plus test and lint tools. Locked with hashes in requirements.txt at the same runtime
# versions as requirements-runtime.txt (the -c constraint). After editing either .in file:
#   (cd backend && pip-compile --generate-hashes --allow-unsafe --strip-extras \
#     requirements.in -o requirements.txt)
-r requirements-runtime.in
-c requirements-runtime.txt
