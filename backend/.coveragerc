# Backend coverage for the Quality gate's unit job: `pytest --cov --cov-report=xml`.
# fail_under is the measured baseline rounded down: 90.10% of 505 statements on 2026-10-04
# (after the C-Class add-on change and the fixed error bodies).
# Raise it as tests are added; never lower it to make a change pass.
[run]
source = app
relative_files = True

[report]
fail_under = 90
show_missing = True
skip_covered = True

[xml]
output = coverage.xml
