# Backend coverage for the Quality gate's unit job: `pytest --cov --cov-report=xml`.
# fail_under sits at least 0.5 points below the measured coverage, rounded down, so an
# unrelated refactor does not fail the gate: 93.00% of 514 statements on 2026-10-04 -> 92.
# Raise it as tests are added; never lower it to make a change pass.
[run]
source = app
relative_files = True

[report]
fail_under = 92
show_missing = True
skip_covered = True

[xml]
output = coverage.xml
