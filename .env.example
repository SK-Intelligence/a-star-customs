# Frontend: leave blank when /api is served on the same origin.
VITE_API_BASE_URL=

# Backend providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Dashboard Dynamic Payment Methods configuration (pmc_...).
# Enable eligible wallets there; Checkout intentionally does not hard-code method types.
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=
# First-order discount: off until the coupon ID is set. The percent must match the coupon.
STRIPE_FIRST_ORDER_COUPON_ID=
FIRST_ORDER_DISCOUNT_CODE=WELCOME10
FIRST_ORDER_DISCOUNT_PERCENT=10
WEB3FORMS_ACCESS_KEY=

# Backend persistence
ORDERS_DATABASE_PATH=./data/orders.db
REVIEWS_DATABASE_PATH=./data/reviews.db

# Browser/API contract
CHECKOUT_SUCCESS_URL=http://localhost:5173/checkout/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://localhost:5173/checkout
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker Compose public origin (replace in production)
PUBLIC_BASE_URL=http://localhost:8080

# Local only: serve FastAPI /docs, /redoc and /openapi.json. Keep false in production.
ENABLE_API_DOCS=false
